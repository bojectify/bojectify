{
  "name": "@bojectify/react-store-async",
  "version": "0.0.1",
  "description": "Async fetch helpers for @bojectify/react-store (REQUEST/SUCCESS/ERROR pattern)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@bojectify/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bojectify/bojectify.git",
    "directory": "packages/react-store-async"
  },
  "homepage": "https://github.com/bojectify/bojectify/tree/main/packages/react-store-async#readme",
  "bugs": "https://github.com/bojectify/bojectify/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@bojectify/react-store": ">=0.0.1"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@bojectify/react-store": "workspace:*"
  },
  "sideEffects": false,
  "nx": {
    "tags": [
      "scope:react-store-async"
    ],
    "targets": {
      "build": {
        "command": "tsup",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
