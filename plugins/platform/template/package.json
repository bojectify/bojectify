{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "build:start": "pnpm build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && node .next/standalone/server.js",
    "lint": "eslint",
    "lint:scss": "stylelint 'src/**/*.scss'",
    "lint:scss:fix": "stylelint 'src/**/*.scss' --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6009",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:screenshots": "vitest run --project screenshots",
    "test:screenshots:update": "./scripts/update-screenshots.sh",
    "codegen:routes": "tsx scripts/generate-routes/index.ts",
    "codegen:tokens": "tsx scripts/generate-tokens/index.ts"
  },
  "dependencies": {
    "@bojectify/react-carousel": "^0.0.1",
    "@bojectify/react-reveal": "^0.0.1",
    "@next/third-parties": "^16.2.0",
    "classnames": "^2.5.1",
    "lodash": "^4.17.23",
    "next": "^16.2.11",
    "next-intl": "^4.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "storybook": "^10.2.12"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "^10.2.12",
    "@storybook/addon-docs": "^10.2.12",
    "@storybook/addon-onboarding": "^10.2.12",
    "@storybook/addon-vitest": "^10.2.12",
    "@storybook/nextjs-vite": "^10.2.12",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.2.12",
    "lefthook": "^2.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "storybook-addon-pseudo-states": "^10.2.17",
    "stylelint": "^17.4.0",
    "stylelint-config-property-sort-order-smacss": "^11.1.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "packageManager": "pnpm@11.5.2"
}
